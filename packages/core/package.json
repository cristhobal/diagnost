{
  "name": "diagnost-core",
  "version": "0.2.1",
  "type": "module",
  "description": "Core diagnostic engine for Astro projects: project discovery, lint rules, filter pipeline, and score calculation.",
  "keywords": ["astro", "lint", "diagnostics", "engine"],
  "homepage": "https://usediagnost.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cristhobal/diagnost.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/cristhobal/diagnost/issues",
  "license": "MIT",
  "author": "cristhobal",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "effect": "^4.0.0-beta.70",
    "picomatch": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
